---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';

const services = [
  { icon: 'ads',       title: 'Publicidad Online',   href: '/servicios-marketing/publicidad-online/',  desc: 'Google Ads y Meta Ads para llegar a tu cliente en el momento exacto en que te busca.' },
  { icon: 'social',    title: 'Redes Sociales',       href: '/servicios-marketing/redes-sociales/',     desc: 'Contenido local, auténtico y publicado con criterio. Sin plantillas genéricas.' },
  { icon: 'web',       title: 'Creamos tu web',       href: '/servicios-marketing/creamos-tu-web/',     desc: 'Webs que aparecen en Google, se ven bien en móvil y convierten visitas en clientes.' },
  { icon: 'email',     title: 'Email Marketing',      href: '/servicios-marketing/email-marketing/',    desc: 'El canal que no depende de ningún algoritmo. Fideliza y vende fuera de temporada.' },
  { icon: 'seo',       title: 'Posicionamiento SEO',  href: '/servicios-marketing/seo-sem-buscadores/', desc: 'Aparece antes que tu competencia cuando te buscan en Google.' },
  { icon: 'formacion', title: 'Formación',            href: '/servicios-marketing/formacion/',          desc: 'Aprende a gestionar tu presencia digital sin depender de nadie.' },
];
---

<BaseLayout
  title="Servicios de Marketing Digital en Luarca · 33setecientos"
  description="Marketing digital para negocios en Luarca y el concejo de Valdés. SEO, Google Ads, Meta Ads, diseño web, redes sociales, email marketing y formación."
>
  <section class="section--light" style="padding-block: 3rem 2rem; border-bottom: 3px solid var(--teal)">
    <div class="container">
      <span class="badge">Servicios</span>
      <h1>Todo lo que necesita tu negocio para crecer online</h1>
      <p class="intro">Somos la agencia de marketing digital de Luarca. Conocemos el mercado local mejor que nadie de fuera. Elige el servicio que necesitas o cuéntanos tu situación y te decimos por dónde empezar.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-grid">
        {services.map((s) => (
          <a href={s.href} class="service-card card">
            <ServiceIcon name={s.icon} />
            <h2>{s.title}</h2>
            <p>{s.desc}</p>
            <span class="link-arrow">Saber más →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--navy" style="padding-block:4rem">
    <div class="container" style="text-align:center">
      <h2 style="color:var(--white);font-size:clamp(1.5rem,3vw,2rem);margin-bottom:.75rem">¿No sabes por dónde empezar?</h2>
      <p style="color:rgba(255,255,255,.75);margin-bottom:2rem">Cuéntanos tu situación en dos líneas y te decimos qué servicio tiene más sentido ahora mismo.</p>
      <a href="/contacto/" class="btn btn-primary">Reserva una cita</a>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { color: var(--navy); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; margin: 0.5rem 0 1rem; }
  .intro { color: var(--grey); font-size: 1.05rem; max-width: 680px; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .service-card { text-decoration: none; color: var(--dark); transition: transform .15s; }
  .service-card:hover { transform: translateY(-3px); }
  .service-icon { font-size: 2rem; margin-bottom: .75rem; display: block; }
  .service-card h2 { color: var(--navy); font-size: 1.1rem; margin-bottom: .4rem; }
  .service-card p { color: var(--grey); font-size: .9rem; margin-bottom: .75rem; }
  .link-arrow { color: var(--teal2); font-weight: 600; font-size: .875rem; }
</style>
