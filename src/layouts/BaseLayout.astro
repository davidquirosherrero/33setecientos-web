---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  pubDate?: Date;
  schema?: object;
  noindex?: boolean;
}

const { title, description, image, imageWidth, imageHeight, type, pubDate, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A2B6B" />
    <!-- Consent Mode v2 defaults — antes de GTM -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 2000
      });
    </script>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MRS2VN3V');</script>
    <!-- End Google Tag Manager -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      type={type}
      pubDate={pubDate}
      noindex={noindex}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/logos/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MRS2VN3V" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <!-- Click tracking: teléfono y WhatsApp → dataLayer -->
    <script>
      (function(){
        document.addEventListener('click', function(e){
          var el = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!el) return;
          var href = el.href || '';
          if (/^tel:/i.test(href)) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({event: 'click_phone'});
          } else if (/wa\.me|api\.whatsapp\.com/i.test(href)) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({event: 'click_whatsapp'});
          }
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main { flex: 1; }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--navy);
    color: var(--white);
    border-radius: 0 0 var(--radius) var(--radius);
    text-decoration: none;
    font-weight: 600;
    z-index: 9999;
    transition: top 0.1s;
  }
  .skip-link:focus { top: 0; }
</style>
