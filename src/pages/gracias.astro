---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mensaje recibido · 33setecientos"
  description="Hemos recibido tu mensaje. Te contactaremos en menos de 24 horas."
>
  <section class="section" style="min-height: 60vh; display:flex; align-items:center">
    <div class="container" style="text-align:center; max-width:560px; margin:0 auto">
      <span style="font-size:3rem" aria-hidden="true">✅</span>
      <h1>Mensaje recibido</h1>
      <p>Te contactaremos en menos de 24 horas. Si necesitas algo urgente, llámanos al <a href="tel:+34984681133" style="color:var(--teal2);font-weight:600">984 68 11 33</a>.</p>
      <a href="/" class="btn btn-primary" style="margin-top:1.5rem">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Conversión: formulario de contacto enviado
  // gtag lo expone GTM una vez cargado — pequeño delay para asegurar que GA4 está listo
  window.addEventListener('load', function() {
    setTimeout(function() {
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'generate_lead', {
          event_category: 'contacto',
          event_label: 'formulario'
        });
      }
    }, 800);
  });
</script>

<style>
  h1 { color: var(--navy); font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 1rem 0; }
  p { color: var(--grey); font-size: 1.05rem; }
</style>
