---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Gestión de Redes Sociales',
  provider: { '@type': 'LocalBusiness', name: '33setecientos', url: 'https://33setecientos.com' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Occidente de Asturias' },
  description: 'Gestión de Instagram y Facebook para negocios de Luarca y Valdés. Contenido local, auténtico y publicado con criterio.',
};

const included = [
  { n: '01', title: 'Perfiles optimizados y activos', desc: 'Configuración o puesta a punto de Instagram y Facebook con información, fotos y coherencia visual.' },
  { n: '02', title: 'Respondemos por ti, con tu voz', desc: 'Gestionamos comentarios, mensajes y reseñas con el tono de tu negocio, no el nuestro.' },
  { n: '03', title: 'Publicaciones que funcionan, no que rellenan', desc: 'Analizamos qué contenido genera interacción real y dejamos de publicar lo que no aporta.' },
  { n: '04', title: 'Meta Ads cuando el orgánico no llega', desc: 'Campañas de pago segmentadas por zona, edad e intereses para llegar a turistas y emigrantes.' },
];
---

<ServiceLayout
  title="Gestión de Redes Sociales en Luarca · 33setecientos"
  description="Gestión de Instagram y Facebook para negocios en Luarca y Valdés. Contenido local y auténtico, sin plantillas genéricas. Desde 33setecientos."
  heading="Redes Sociales"
  subheading="Gestión de redes sociales para negocios en Luarca y Valdés. Que tu negocio esté presente donde están tus clientes."
  schema={schema}
>
  <section class="section">
    <div class="container">
      <h2>Por qué las redes sociales importan en un concejo como Valdés</h2>
      <p class="intro">Los clientes buscan tu negocio en Instagram antes de visitarlo o comprar. Un perfil abandonado te hace perder frente a la competencia. En un concejo pequeño, la cercanía y la autenticidad pesan más que la producción profesional — y nosotros somos de la zona.</p>

      <h2 style="margin-top:3rem">Qué incluye la gestión de tus redes</h2>
      <div class="steps">
        {included.map((s) => (
          <div class="step card">
            <span class="step-n">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <h2>Una agencia que conoce tu calle, no solo tu sector</h2>
      <p>Todo el contenido se crea en Luarca, sin subcontratar fuera. Sabemos cuándo es la Feria Medieval, cuándo llegan los turistas del eclipse y cómo habla la gente del concejo. Eso se nota en el contenido.</p>
      <p>Contáctanos y te mostramos ejemplos concretos para tu sector en menos de 24 horas.</p>
    </div>
  </section>
</ServiceLayout>

<style>
  .intro { color: var(--grey); max-width: 680px; margin-bottom: 2.5rem; font-size: 1.05rem; }
  h2 { color: var(--navy); font-size: clamp(1.4rem, 2.5vw, 1.8rem); margin-bottom: 1rem; }
  .steps { display: flex; flex-direction: column; gap: 1rem; }
  .step { display: flex; gap: 1.5rem; align-items: flex-start; }
  .step-n { font-size: 1.5rem; font-weight: 800; color: var(--teal); min-width: 2.5rem; }
  .step h3 { color: var(--navy); margin-bottom: .25rem; }
  .step p { color: var(--grey); font-size: .95rem; margin: 0; }
  .section--light p { color: var(--grey); max-width: 680px; }
</style>
