---
import BaseLayout from "../layouts/BaseLayout.astro";
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "33setecientos — Marketing Digital en Vegadeo",
  url: "https://33setecientos.com/marketing-digital-vegadeo/",
  telephone: "+34984681133",
  areaServed: { "@type": "AdministrativeArea", name: "Vegadeo, Asturias" },
};
---
<BaseLayout
  title="Marketing Digital en Vegadeo · 33setecientos"
  description="Agencia de marketing digital para negocios de Vegadeo. SEO local, Google Ads, redes sociales y diseño web. Desde Luarca, occidente de Asturias."
  schema={schema}
>
  <section class="section--navy hero">
    <div class="container">
      <span class="badge" style="background:rgba(255,255,255,.15);color:var(--white)">Vegadeo · Asturias</span>
      <h1>Marketing Digital para negocios en Vegadeo</h1>
      <p>Vegadeo es el municipio más comercial del extremo occidental de Asturias. Su posición en la frontera con Galicia y su condición de centro de servicios para los municipios del entorno le dan una actividad económica diversificada: talleres, comercio, servicios profesionales, hostelería.</p>
      <a href="/contacto/" class="btn btn-primary" style="margin-top:1.5rem;display:inline-block">Consulta gratuita</a>
    </div>
  </section>
  <section class="section">
    <div class="container content-col">
      <h2>¿Por qué contratar marketing digital en Vegadeo?</h2>
      <p>Los negocios de Vegadeo compiten no solo con los del municipio, sino con los de ambos lados de la frontera con Galicia. El cliente tiene alternativas a un clic de distancia. Aparecer bien en Google cuando busca tu servicio en Vegadeo y alrededores marca la diferencia entre que te llame a ti o a tu competencia.</p>
      <p>En 33setecientos hacemos SEO local, Google Ads y gestión de redes sociales para negocios de Vegadeo. Sabemos cómo funciona el mercado del occidente de Asturias y la competencia transfronteriza.</p>
    </div>
  </section>
  <section class="section section--light">
    <div class="container">
      <h2>Servicios para negocios de Vegadeo</h2>
      <div class="svc-grid">
        {[
          { href: "/servicios-marketing/seo-sem-buscadores/", title: "SEO en Vegadeo", desc: "Aparece cuando buscan tu servicio en Vegadeo. Google My Business, búsquedas locales y contenido posicionado." },
          { href: "/servicios-marketing/publicidad-online/", title: "Google Ads y Meta Ads", desc: "Campañas segmentadas para Vegadeo y occidente de Asturias. Solo pagas cuando te hacen clic." },
          { href: "/servicios-marketing/redes-sociales/", title: "Redes Sociales", desc: "Instagram y Facebook gestionados para captar cliente local y de Galicia limítrofe." },
          { href: "/servicios-marketing/creamos-tu-web/", title: "Diseño Web", desc: "Webs rápidas, posicionadas y que convierten visitas en clientes." },
        ].map((s) => (
          <a href={s.href} class="card svc-card">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="link-arrow">Saber más →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--navy">
    <div class="container" style="text-align:center">
      <h2 style="color:var(--white);font-size:clamp(1.5rem,3vw,2rem);margin-bottom:.75rem">¿Tienes un negocio en Vegadeo?</h2>
      <p style="color:rgba(255,255,255,.75);margin-bottom:2rem">Primera consulta gratuita. Te decimos qué tiene más sentido para tu negocio ahora mismo.</p>
      <a href="/contacto/" class="btn btn-primary">Contactar</a>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: clamp(3rem,6vw,5rem); }
  h1 { color: var(--white); font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 800; margin: .75rem 0 1rem; max-width: 680px; }
  .hero p { color: rgba(255,255,255,.8); max-width: 600px; }
  h2 { color: var(--navy); font-size: clamp(1.3rem,2.5vw,1.8rem); margin-bottom: 1rem; }
  .content-col { max-width: 720px; }
  .content-col p { color: var(--grey); line-height: 1.7; margin-bottom: 1rem; }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
  .svc-card { text-decoration: none; color: var(--dark); transition: transform .15s; }
  .svc-card:hover { transform: translateY(-3px); }
  .svc-card h3 { color: var(--navy); font-size: 1rem; margin-bottom: .4rem; }
  .svc-card p { color: var(--grey); font-size: .9rem; margin-bottom: .75rem; }
  .link-arrow { color: var(--teal2); font-weight: 600; font-size: .875rem; }
</style>
