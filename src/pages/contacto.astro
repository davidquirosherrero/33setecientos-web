---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto · 33setecientos — Agencia de Marketing en Luarca"
  description="Contacta con 33setecientos, la agencia de marketing digital de Luarca. Te respondemos en menos de 24 horas. Tel: 984 68 11 33."
>
  <section class="section--light contact-hero">
    <div class="container">
      <span class="badge">Contacto</span>
      <h1>Estamos en Luarca.<br />Conocemos tu negocio.</h1>
      <p>Trabajamos con negocios del concejo de Valdés y el occidente de Asturias. Cuéntanos qué necesitas. No hace falta tener un resumen preparado — con saber dónde estás y qué te preocupa es suficiente.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">

      <div class="contact-form-col">
        <h2>Escríbenos</h2>
        <p>Te respondemos en menos de 24 horas.</p>
        <form
          name="contacto"
          method="POST"
          action="/gracias/"
          data-netlify="true"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contacto" />

          <div class="field">
            <label for="nombre">Nombre *</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
          </div>

          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
          </div>

          <div class="field">
            <label for="telefono">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" placeholder="Opcional" />
          </div>

          <div class="field">
            <label for="mensaje">¿En qué podemos ayudarte? *</label>
            <textarea id="mensaje" name="mensaje" required rows="5" placeholder="Cuéntanos tu situación en dos líneas..."></textarea>
          </div>

          <div class="field field--check">
            <input type="checkbox" id="privacidad" name="privacidad" required />
            <label for="privacidad">He leído y acepto la <a href="/politica-privacidad/">política de privacidad</a></label>
          </div>

          <button type="submit" class="btn btn-primary btn-full">Enviar mensaje</button>
        </form>
      </div>

      <div class="contact-info-col">
        <h2>También puedes contactarnos directamente</h2>
        <p>Teléfono y WhatsApp disponibles en horario de oficina.</p>

        <div class="contact-items">
          <a href="tel:+34984681133" class="contact-item card">
            <span class="contact-icon" aria-hidden="true">📞</span>
            <div>
              <strong>Teléfono</strong>
              <span>984 68 11 33</span>
            </div>
          </a>

          <a href="https://wa.me/34984681133" class="contact-item card" target="_blank" rel="noopener noreferrer">
            <span class="contact-icon" aria-hidden="true">💬</span>
            <div>
              <strong>WhatsApp</strong>
              <span>+34 984 68 11 33</span>
            </div>
          </a>

          <a href="mailto:info@33setecientos.com" class="contact-item card">
            <span class="contact-icon" aria-hidden="true">✉️</span>
            <div>
              <strong>Email</strong>
              <span>info@33setecientos.com</span>
            </div>
          </a>

          <div class="contact-item card">
            <span class="contact-icon" aria-hidden="true">📍</span>
            <div>
              <strong>Dirección</strong>
              <span>Centro de Empresas, Polígono Industrial de Barcia - Almuña, Luarca</span>
            </div>
          </div>
        </div>

        <div class="card newsletter-box">
          <h3>Newsletter</h3>
          <p>Consejos de marketing para negocios locales. Sin spam.</p>
          <form name="newsletter" method="POST" data-netlify="true" class="newsletter-form">
            <input type="hidden" name="form-name" value="newsletter" />
            <input type="email" name="email" required placeholder="tu@email.com" />
            <button type="submit" class="btn btn-primary">Suscribirme</button>
          </form>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { padding-block: 3rem 2rem; border-bottom: 3px solid var(--teal); }
  .contact-hero h1 { color: var(--navy); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; margin: .5rem 0 1rem; }
  .contact-hero p { color: var(--grey); max-width: 640px; font-size: 1.05rem; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }

  h2 { color: var(--navy); font-size: 1.4rem; margin-bottom: .5rem; }
  .section > .container > * + * { margin-top: 0; }

  /* Form */
  .contact-form-col > p { color: var(--grey); margin-bottom: 1.5rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: .35rem; }
  .field label { font-size: .875rem; font-weight: 600; color: var(--navy); }
  .field input, .field textarea {
    border: 1.5px solid var(--lgrey);
    border-radius: .5rem;
    padding: .6rem .9rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--dark);
    transition: border-color .15s;
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--teal); }
  .field textarea { resize: vertical; }
  .field--check { flex-direction: row; align-items: center; gap: .5rem; }
  .field--check input { width: auto; }
  .field--check label { font-size: .875rem; font-weight: 400; color: var(--grey); }
  .field--check a { color: var(--teal2); }
  .btn-full { width: 100%; justify-content: center; }

  /* Info */
  .contact-info-col > p { color: var(--grey); margin-bottom: 1.5rem; }
  .contact-items { display: flex; flex-direction: column; gap: .75rem; margin-bottom: 1.5rem; }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--dark);
    transition: transform .1s;
  }
  a.contact-item:hover { transform: translateX(3px); }
  .contact-icon { font-size: 1.4rem; min-width: 2rem; }
  .contact-item strong { display: block; color: var(--navy); font-size: .875rem; margin-bottom: .1rem; }
  .contact-item span { color: var(--grey); font-size: .9rem; }

  .newsletter-box h3 { color: var(--navy); margin-bottom: .35rem; }
  .newsletter-box p { color: var(--grey); font-size: .9rem; margin-bottom: 1rem; }
  .newsletter-form { display: flex; gap: .5rem; }
  .newsletter-form input {
    flex: 1;
    border: 1.5px solid var(--lgrey);
    border-radius: .5rem;
    padding: .6rem .9rem;
    font-size: .9rem;
    font-family: inherit;
  }
  .newsletter-form input:focus { outline: none; border-color: var(--teal); }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .newsletter-form { flex-direction: column; }
    .newsletter-form .btn { width: 100%; }
  }
</style>
