---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  subheading?: string;
  schema?: object;
  heroImage?: string;
  heroAlt?: string;
}
const { title, description, heading, subheading, schema, heroImage, heroAlt } = Astro.props;
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="service-hero section--light">
    <div class={`container ${heroImage ? 'hero-with-img' : ''}`}>
      <div class="hero-text">
        <a href="/servicios-marketing/" class="breadcrumb">← Todos los servicios</a>
        <h1>{heading}</h1>
        {subheading && <p class="service-intro">{subheading}</p>}
      </div>
      {heroImage && (
        <div class="hero-img-wrap">
          <img src={heroImage} alt={heroAlt ?? heading} loading="eager" />
        </div>
      )}
    </div>
  </div>

  <slot />

  <section class="service-cta section--navy">
    <div class="container cta-center">
      <h2>¿Hablamos?</h2>
      <p>Primera consulta gratuita. Te decimos qué tiene sentido para tu negocio ahora mismo.</p>
      <div class="cta-btns">
        <a href="/contacto/" class="btn btn-primary">Contactar</a>
        <a href="https://wa.me/34984681133" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:var(--white)" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    padding-block: 3rem 2.5rem;
    border-bottom: 3px solid var(--teal);
  }
  .hero-with-img {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-img-wrap img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 4px 20px rgba(26,43,107,0.12);
  }
  .breadcrumb {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--grey);
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .breadcrumb:hover { color: var(--teal2); }
  .service-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--navy);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .service-intro {
    font-size: 1.1rem;
    color: var(--grey);
    max-width: 640px;
    margin: 0;
  }
  @media (max-width: 768px) {
    .hero-with-img { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-img-wrap { order: -1; }
    .hero-img-wrap img { height: 200px; }
  }
  .service-cta { padding-block: 4rem; }
  .cta-center { text-align: center; }
  .cta-center h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--white); margin-bottom: 0.75rem; }
  .cta-center p { color: rgba(255,255,255,0.75); margin-bottom: 2rem; }
  .cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
