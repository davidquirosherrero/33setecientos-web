---
const navLinks = [
  { label: 'Inicio', href: '/' },
  {
    label: 'Servicios',
    href: '/servicios-marketing/',
    children: [
      { label: 'Publicidad Online', href: '/servicios-marketing/publicidad-online/' },
      { label: 'Redes Sociales',    href: '/servicios-marketing/redes-sociales/' },
      { label: 'Creamos tu web',    href: '/servicios-marketing/creamos-tu-web/' },
      { label: 'Email Marketing',   href: '/servicios-marketing/email-marketing/' },
      { label: 'Posicionamiento SEO', href: '/servicios-marketing/seo-sem-buscadores/' },
      { label: 'Formación',         href: '/servicios-marketing/formacion/' },
    ],
  },
  { label: 'Blog', href: '/blog-marketing-luarca/' },
  { label: 'Contacto', href: '/contacto/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-bar">
    <a href="/" class="header-logo" aria-label="33setecientos — Inicio">
      <img src="/images/logos/logo-horizontal.svg" alt="33setecientos" width="113" height="40" style="height:40px;width:113px;display:block;max-width:none;" />
    </a>

    <!-- Nav desktop -->
    <nav class="desk-nav" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <div class={link.children ? 'nav-item has-drop' : 'nav-item'}>
          <a
            href={link.href}
            class={currentPath === link.href ? 'active' : ''}
          >
            {link.label}{link.children && <span aria-hidden="true"> ▾</span>}
          </a>
          {link.children && (
            <div class="dropdown">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class={currentPath === child.href ? 'active' : ''}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <a href="/contacto/" class="btn btn-primary desk-cta">Contacta ahora</a>

    <button id="mob-toggle" aria-expanded="false" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Panel móvil — fuera del flex row -->
  <nav id="mob-nav" aria-label="Menú móvil" hidden>
    {navLinks.map((link) => (
      <div class="mob-item">
        <a href={link.href} class={currentPath === link.href ? 'active' : ''}>
          {link.label}
        </a>
        {link.children && (
          <div class="mob-sub">
            {link.children.map((child) => (
              <a href={child.href} class={currentPath === child.href ? 'active' : ''}>
                {child.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <a href="/contacto/" class="btn btn-primary mob-cta">Contacta ahora</a>
  </nav>
</header>

<style is:global>
  /* ── Header ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid #e8eaf0;
    box-shadow: 0 1px 4px rgba(26,43,107,.06);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .header-logo {
    flex-shrink: 0;
    line-height: 0;
    display: flex;
    align-items: center;
    height: 44px;
    overflow: hidden;
  }

  /* ── Desktop nav ── */
  .desk-nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item { position: relative; }

  .desk-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: .9rem;
    font-weight: 500;
    color: #1e293b;
    text-decoration: none;
    border-radius: 6px;
    white-space: nowrap;
    transition: color .15s, background .15s;
  }
  .desk-nav a:hover,
  .desk-nav a.active {
    color: #1a2b6b;
    background: #f0f2f8;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(26,43,107,.12);
    min-width: 220px;
    padding: 0.5rem;
    z-index: 200;
  }
  .has-drop:hover .dropdown,
  .has-drop:focus-within .dropdown { display: block; }

  .dropdown a {
    font-size: .875rem;
    padding: .4rem .75rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .desk-cta { font-size: .875rem; white-space: nowrap; flex-shrink: 0; }

  /* ── Hamburger ── */
  #mob-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  #mob-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #1a2b6b;
    border-radius: 2px;
    transition: transform .2s;
  }

  /* ── Mobile panel ── */
  #mob-nav {
    background: #fff;
    border-top: 1px solid #e8eaf0;
    padding: .5rem 1rem 1.25rem;
  }

  .mob-item > a {
    display: block;
    padding: .75rem .25rem;
    font-size: 1rem;
    font-weight: 500;
    color: #1e293b;
    text-decoration: none;
    border-bottom: 1px solid #e8eaf0;
  }
  .mob-item > a.active { color: #1a2b6b; }

  .mob-sub { padding: .25rem 0 .5rem 1rem; }
  .mob-sub a {
    display: block;
    padding: .5rem .25rem;
    font-size: .9rem;
    color: #475569;
    text-decoration: none;
    border-bottom: 1px solid #f0f2f8;
  }
  .mob-sub a:last-child { border-bottom: none; }
  .mob-sub a:hover { color: #1a2b6b; }

  .mob-cta { margin-top: 1rem; display: inline-block; }

  /* ── Breakpoint ── */
  @media (max-width: 768px) {
    .desk-nav,
    .desk-cta { display: none !important; }
    #mob-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('mob-toggle') as HTMLButtonElement;
  const mobNav = document.getElementById('mob-nav') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (open) {
      mobNav.setAttribute('hidden', '');
    } else {
      mobNav.removeAttribute('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    const header = document.querySelector('.site-header');
    if (header && !header.contains(e.target as Node)) {
      toggle?.setAttribute('aria-expanded', 'false');
      mobNav?.setAttribute('hidden', '');
    }
  });
</script>
