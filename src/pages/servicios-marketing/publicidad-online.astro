---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Publicidad Online — Google Ads y Meta Ads',
  provider: { '@type': 'LocalBusiness', name: '33setecientos', url: 'https://33setecientos.com' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Occidente de Asturias' },
  description: 'Gestión de campañas de publicidad online en Google Ads y Meta Ads para negocios de Luarca y el concejo de Valdés.',
};

const steps = [
  { n: '01', title: 'Estrategia antes de gastar un euro', desc: 'Analizamos el mercado local, la competencia real y la plataforma más adecuada para cada tipo de cliente.' },
  { n: '02', title: 'Anuncios que suenan a ti, no a plantilla', desc: 'Creamos textos y creatividades desde cero, que tú revisas y apruebas antes de publicar.' },
  { n: '03', title: 'El presupuesto trabaja, no se malgasta', desc: 'Monitorizamos las campañas cada semana, escalamos lo que funciona y cortamos lo que no.' },
  { n: '04', title: 'Google, Meta, o los dos — donde esté tu cliente', desc: 'Google Ads capta a quien ya te busca. Meta Ads impacta a quien aún no sabe que te necesita. Decidimos juntos.' },
];
---

<ServiceLayout
  title="Publicidad Online — Google Ads y Meta Ads en Luarca · 33setecientos"
  description="Gestión de Google Ads y Meta Ads para negocios en Luarca y Valdés. Campañas segmentadas por zona y temporada. Primer mes sin permanencia."
  heading="Publicidad Online"
  subheading="Google Ads y Meta Ads para negocios en Luarca y Valdés. Llega a tu cliente en el momento exacto en que te está buscando."
  schema={schema}
>
  <section class="section">
    <div class="container">
      <h2>Cómo gestionamos tu publicidad</h2>
      <p class="section-intro">Tú te ocupas de tu negocio. Nosotros de que te encuentren. Gestionamos las campañas como parte del equipo: reunión mensual e informe claro, sin tecnicismos.</p>
      <div class="steps">
        {steps.map((s) => (
          <div class="step card">
            <span class="step-n">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container two-col">
      <div>
        <h2>Configuración y gestión completa</h2>
        <p>Nos encargamos de cuentas publicitarias, audiencias, pujas y segmentación por zona y temporada. Sin que tengas que aprender nada de la plataforma.</p>
      </div>
      <div>
        <h2>Creatividades que conectan con el cliente local</h2>
        <p>Textos, imágenes y vídeos adaptados a tu marca y al cliente de Luarca y el occidente de Asturias. Nada genérico.</p>
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .section-intro { color: var(--grey); max-width: 640px; margin-bottom: 2.5rem; font-size: 1.05rem; }
  h2 { color: var(--navy); font-size: clamp(1.4rem, 2.5vw, 1.8rem); margin-bottom: 1rem; }
  .steps { display: flex; flex-direction: column; gap: 1rem; }
  .step { display: flex; gap: 1.5rem; align-items: flex-start; }
  .step-n { font-size: 1.5rem; font-weight: 800; color: var(--teal); min-width: 2.5rem; }
  .step h3 { color: var(--navy); margin-bottom: .25rem; }
  .step p { color: var(--grey); font-size: .95rem; margin: 0; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .two-col p { color: var(--grey); }
  @media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
</style>
