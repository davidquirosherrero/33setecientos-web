---
// Cookie banner GDPR — Consent Mode v2
// GTM ya está cargado en el <head>. Este banner solo actualiza el estado de consent.
---

<div id="cookie-banner" class="cookie-banner" role="alertdialog" aria-label="Aviso de cookies" aria-describedby="cookie-desc">
  <div class="cookie-inner">
    <p id="cookie-desc">
      Usamos cookies propias y de terceros (Google Analytics, Meta/Facebook) para analizar el tráfico y mejorar tu experiencia.
      <a href="/politica-privacidad/" class="cookie-link">Política de privacidad</a>
    </p>
    <div class="cookie-btns">
      <button id="cookie-reject" class="btn-cookie btn-cookie--outline">Rechazar</button>
      <button id="cookie-accept" class="btn-cookie btn-cookie--primary">Aceptar</button>
    </div>
  </div>
</div>

<script>
  const COOKIE_KEY = 'cookie_consent_33set';

  function getCookieConsent() {
    try { return localStorage.getItem(COOKIE_KEY); } catch { return null; }
  }

  function setCookieConsent(value: string) {
    try { localStorage.setItem(COOKIE_KEY, value); } catch {}
  }

  function hideBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.style.display = 'none';
  }

  function grantConsent() {
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) { (window as any).dataLayer.push(args); }
    gtag('consent', 'update', {
      'analytics_storage': 'granted',
      'ad_storage': 'granted',
      'ad_user_data': 'granted',
      'ad_personalization': 'granted'
    });
    (window as any).dataLayer.push({ event: 'consent_accepted' });
  }

  function denyConsent() {
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) { (window as any).dataLayer.push(args); }
    gtag('consent', 'update', {
      'analytics_storage': 'denied',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied'
    });
  }

  // On load: aplicar consent guardado
  const consent = getCookieConsent();
  if (consent === 'accepted') {
    hideBanner();
    grantConsent();
  } else if (consent === 'rejected') {
    hideBanner();
    denyConsent();
  }
  // Sin consent previo: mostrar banner

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    setCookieConsent('accepted');
    hideBanner();
    grantConsent();
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    setCookieConsent('rejected');
    hideBanner();
    denyConsent();
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--dark);
    color: var(--white);
    padding: 1rem;
    box-shadow: 0 -4px 20px rgba(0,0,0,.25);
  }
  .cookie-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cookie-inner p {
    font-size: .875rem;
    color: rgba(255,255,255,.8);
    margin: 0;
    flex: 1;
    min-width: 200px;
  }
  .cookie-link { color: var(--teal); text-decoration: underline; }
  .cookie-btns { display: flex; gap: .75rem; flex-shrink: 0; }
  .btn-cookie {
    padding: .5rem 1.25rem;
    border-radius: .4rem;
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  .btn-cookie--primary { background: var(--teal); color: var(--dark); }
  .btn-cookie--primary:hover { background: var(--teal2); }
  .btn-cookie--outline { background: transparent; color: rgba(255,255,255,.7); border: 1px solid rgba(255,255,255,.3); }
  .btn-cookie--outline:hover { background: rgba(255,255,255,.1); color: var(--white); }
</style>
