---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="33setecientos — Inicio">
        <img src="/images/logos/logo.png" alt="33setecientos" style="height:48px;width:auto;" />
      </a>
      <p>Agencia de marketing digital<br />para negocios del occidente de Asturias.</p>
    </div>

    <nav class="footer-nav" aria-label="Servicios">
      <h3>Servicios</h3>
      <ul role="list">
        <li><a href="/servicios-marketing/publicidad-online/">Publicidad Online</a></li>
        <li><a href="/servicios-marketing/redes-sociales/">Redes Sociales</a></li>
        <li><a href="/servicios-marketing/creamos-tu-web/">Creamos tu web</a></li>
        <li><a href="/servicios-marketing/email-marketing/">Email Marketing</a></li>
        <li><a href="/servicios-marketing/seo-sem-buscadores/">Posicionamiento SEO</a></li>
        <li><a href="/servicios-marketing/formacion/">Formación</a></li>
      </ul>
    </nav>

    <nav class="footer-nav" aria-label="Información">
      <h3>Información</h3>
      <ul role="list">
        <li><a href="/blog-marketing-luarca/">Blog</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-privacidad/">Política de privacidad</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <h3>Contacto</h3>
      <address>
        <p>Centro de Empresas<br />Polígono Industrial Barcia - Almuña<br />Luarca, Asturias</p>
        <a href="tel:+34984681133">984 68 11 33</a><br />
        <a href="mailto:info@33setecientos.com">info@33setecientos.com</a>
      </address>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} 33setecientos. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--white);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-block: 3.5rem;
  }

  .footer-brand img { margin-bottom: 1rem; }
  .footer-brand p { color: rgba(255,255,255,0.65); font-size: 0.9rem; line-height: 1.5; }

  .footer-nav h3,
  .footer-contact h3 {
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .footer-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }

  .footer-nav a,
  .footer-contact a {
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }
  .footer-nav a:hover,
  .footer-contact a:hover { color: var(--teal); }

  .footer-contact address { font-style: normal; }
  .footer-contact p { color: rgba(255,255,255,0.65); font-size: 0.9rem; margin-bottom: 0.75rem; }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-block: 1.25rem;
  }
  .footer-bottom p { font-size: 0.8rem; color: rgba(255,255,255,0.4); margin: 0; }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
