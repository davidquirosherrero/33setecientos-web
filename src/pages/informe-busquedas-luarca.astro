---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Cuánto busca Google tu negocio en Luarca · 33setecientos"
  description="+75.000 búsquedas mensuales sobre Luarca. Datos reales de Google Keyword Planner por sector y por nombre de negocio. Informe de 33setecientos."
>
  <style>
    .iframe-wrap {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 10;
    }
    .iframe-wrap iframe {
      width: 100%; height: 100%;
      border: none;
      display: block;
    }
  </style>
  <div class="iframe-wrap">
    <iframe src="/informe-busquedas-luarca.html" title="Informe de búsquedas en Luarca" allowfullscreen></iframe>
  </div>
</BaseLayout>
